# Regra de Regex para captura do texto a traduzir (aceita /regex/flags ou regex pura)
RULE=/\bt\('([^']+)'\)/g

# Lista de idiomas separados por vírgula para tradução
LANGS=pt,pt-BR,en,es

# Idioma base padrão para extração de textos
BASE_LANG=pt-br

# Diretórios para escanear (separados por vírgula)
SCAN_FOLDERS=src

# Pastas a serem ignoradas/excluídas da busca (separadas por vírgula)
IGNORE_FOLDERS=src/i18n-old

# Extensões dos arquivos que serão escaneados
FILE_EXTENSIONS=.ts,.tsx,.js,.jsx,.vue,.svelte,.html

# Diretório onde os arquivos JSON de tradução são gerados e lidos
OUTPUT_DIR=src/i18n

# Configurações do LibreTranslate
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_PORT=5000
LIBRETRANSLATE_API_KEY=

# Chave oficial do Google Cloud Translation API (opcional para o provedor google)
GOOGLE_TRANSLATE_API_KEY=

# Provedor padrão: libretranslate ou google
TRANSLATE_PROVIDER=libretranslate

# Otimizações de velocidade (Modo Turbo)
TRANSLATE_BATCH_SIZE=25
TRANSLATE_CONCURRENCY=6
